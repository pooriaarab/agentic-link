{
  "name": "agentic-link",
  "version": "0.0.0",
  "description": "Share a document as a link: the content lives in the URL, with no account and no server read.",
  "keywords": [
    "share",
    "link",
    "url",
    "snapshot",
    "privacy",
    "encryption",
    "no-account",
    "agents",
    "mcp",
    "cli"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-link.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-link",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-link": "./dist/cli.js",
    "agentic-link-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
