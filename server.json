{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.pooriaarab/agentic-link",
  "description": "Share a document as a link: the content lives in the URL, with no account and no server read.",
  "version": "0.2.0",
  "repository": {
    "url": "https://github.com/pooriaarab/agentic-link",
    "source": "github",
    "id": 0
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "agentic-link",
      "version": "0.2.0",
      "transport": { "type": "stdio" },
      "runtimeHint": "npx",
      "packageArguments": [
        { "type": "positional", "valueHint": "subcommand", "value": "mcp" }
      ]
    }
  ]
}
