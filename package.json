{
  "name": "agentic-link",
  "version": "0.5.0",
  "description": "Share a document as a link: the content lives in the URL, with no account and no server read.",
  "keywords": [
    "share",
    "link",
    "url",
    "snapshot",
    "privacy",
    "encryption",
    "no-account",
    "agents",
    "mcp",
    "cli"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-link.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "llms.txt",
    "SKILL.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-link",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./account": {
      "types": "./dist/account.d.ts",
      "import": "./dist/account.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:demo": "WRANGLER_SEND_METRICS=false wrangler deploy --config wrangler.demo.jsonc",
    "clean": "rm -rf dist",
    "dev": "WRANGLER_SEND_METRICS=false wrangler dev --port 8795",
    "dev:smoke": "node scripts/dev-smoke.mjs 8795 /health",
    "ci:local": "WRANGLER_SEND_METRICS=false npm run build && npm run typecheck && npm test",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.23.0",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "agentic-identity": "^0.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.155.0"
  },
  "bin": {
    "agentic-link": "./dist/cli.js",
    "agentic-link-mcp": "./dist/mcp-bin.js"
  }
}
